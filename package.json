{
  "name": "remotetv",
  "version": "1.0.0",
  "description": "Ad-free, multi-brand TV remote (Sony Bravia, Android/Google TV, Roku, LG webOS, Samsung Tizen) with DLNA/DIAL casting, served as a phone PWA from a small Node.js hub.",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test --test-force-exit --test-timeout=60000 test/*.test.js",
    "build:web": "node scripts/vendor.js",
    "android:sync": "npm run build:web && npx cap sync android"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "androidtv-remote": "^1.0.10",
    "bonjour-service": "^1.4.4",
    "express": "^4.22.3",
    "node-forge": "^1.4.3",
    "protobufjs": "^7.6.6",
    "selfsigned": "^2.4.1",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0"
  }
}
